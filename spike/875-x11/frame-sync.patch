+/// Turns off GDK's frame sync for every page window. wry parents each page's
+/// GTK window into GPUI's X11 window, where no window manager or compositor
+/// manages it, so `_NET_WM_FRAME_DRAWN` never arrives for it. With sync on,
+/// GDK froze the window after its first frame to wait for that message, and a
+/// page whose first paint lost the race stayed black until hidden (#875's X11
+/// qualification: the second tab). GDK documents turning sync off for windows
+/// embedded this way. Every GTK toplevel here is a page window: GPUI isn't GTK.
+pub fn embedded() {
+    if READY.with(Cell::get) != Some(true) {
+        return;
+    }
+    // SAFETY: GTK was initialized on this thread by `gtk_ready`. The list
+    // holds borrowed widgets and is freed here; each window is checked.
+    unsafe {
+        let list = gtk_window_list_toplevels();
+        let mut node = list;
+        while !node.is_null() {
+            let window = gtk_widget_get_window((*node).data);
+            if !window.is_null() {
+                gdk_x11_window_set_frame_sync_enabled(window, 0);
+            }
+            node = (*node).next;
+        }
+        g_list_free(list);
+    }
+}
