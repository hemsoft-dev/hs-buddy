index 0000000000000000000000000000000000000000..624399d31884e505ae401d4677e54c4d371048f9
--- /dev/null
+++ b/scripts/rebuild.js
@@ -0,0 +1,6 @@
+// Invoke the installed tool directly: Bun's node-gyp shim can fetch @latest.
+const { spawnSync } = require('node:child_process');
+const executable = require.resolve('node-gyp/bin/node-gyp.js');
+const result = spawnSync(process.execPath, [executable, 'rebuild'], { stdio: 'inherit' });
+if (result.error) throw result.error;
+process.exit(result.status ?? 1);
