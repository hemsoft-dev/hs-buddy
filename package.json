{
  "name": "@hemsoft/buddy",
  "private": true,
  "version": "0.1.1401",
  "description": "Your universal productivity companion - manage skills, tasks, and workflows",
  "type": "module",
  "main": "dist-electron/main.js",
  "files": [
    "dist",
    "dist-electron/main.js"
  ],
  "scripts": {
    "dev": "vite",
    "setup": "bun scripts/setup.ts",
    "build": "bun run bump && tsc && vite build && electron-builder",
    "package:smoke": "bun scripts/package-smoke.ts",
    "bump": "bun scripts/bump-revision.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:quality": "bun scripts/check-readme-metadata.ts && bun scripts/lint-quality.ts",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint --dot --config .markdownlint-cli2.jsonc --configPointer /config \"**/*.md\"",
    "lint:md:fix": "markdownlint --dot --config .markdownlint-cli2.jsonc --configPointer /config --fix \"**/*.md\"",
    "format": "prettier --write \"{src,shared,electron,convex,scripts,e2e,perf}/**/*.{ts,tsx,js,json,css}\"",
    "format:check": "prettier --check \"{src,shared,electron,convex,scripts,e2e,perf}/**/*.{ts,tsx,js,json,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:completion-audio": "node --experimental-strip-types --test .pi/tests/done-sound.test.mjs",
    "test:a11y": "vitest run --reporter=verbose -t \"no accessibility violations\"",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:electron": "vitest run --config vitest.electron.config.ts",
    "test:electron:coverage": "vitest run --config vitest.electron.config.ts --coverage",
    "test:convex": "vitest run --config vitest.convex.config.ts",
    "test:convex:coverage": "vitest run --config vitest.convex.config.ts --coverage",
    "react-doctor": "bun scripts/run-react-doctor.ts",
    "lhci": "lhci autorun",
    "bench": "vitest bench",
    "bench:json": "bun scripts/bench-json.ts",
    "bench:median": "bun scripts/bench-median.ts",
    "bench:compare": "bun scripts/bench-compare.ts",
    "bench:update": "bun run bench:json && bun scripts/bench-compare.ts --update",
    "perf:memory:node": "bun perf/node-memory-monitor.ts",
    "perf:memory:electron": "bun perf/electron-memory.ts",
    "perf:startup": "bun perf/run-startup.ts",
    "pretypecheck": "bun scripts/checkAspireBootstrap.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.convex.json && bun run --cwd aspire-apphost typecheck",
    "knip": "knip",
    "e18e": "bun scripts/run-e18e.ts",
    "e18e:migrate": "e18e-cli migrate --all",
    "deps:check": "depcruise src electron convex shared --config .dependency-cruiser.cjs",
    "security:electron": "bun scripts/check-electron-security.ts",
    "security:csp": "bun scripts/check-production-csp.ts",
    "coverage:perfection": "bun scripts/coverage-perfection.ts",
    "coverage:perfection:strict": "bun scripts/coverage-perfection.ts --strict",
    "coverage:ratchet": "bun scripts/coverage-ratchet.ts",
    "coverage:ratchet:electron": "bun scripts/coverage-ratchet.ts --config vitest.electron.config.ts --summary coverage-electron/coverage-summary.json",
    "bundle-size": "bun scripts/bundle-size.ts",
    "bundle-size:update": "bun scripts/bundle-size.ts --update",
    "preview": "vite preview",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:codegen": "convex codegen",
    "test:e2e": "npx playwright test --project=browser-e2e",
    "test:e2e:electron": "bun scripts/run-electron-e2e.ts",
    "test:e2e:install": "npx playwright install chrome",
    "test:ipc-contracts": "vitest run src/ipc/contracts.test.ts src/ipc/contracts.registration.test.ts",
    "prepare": "husky",
    "postinstall": "node scripts/install-native-pty.mjs",
    "crap:coverage": "bun scripts/crap-coverage.ts",
    "crap": "bun scripts/crap-report.ts",
    "crap:check": "bun run crap:coverage && bun run crap",
    "crap:ratchet": "bun scripts/crap-report.ts --update-baseline",
    "native:toolchain": "node scripts/check-native-toolchain.mjs",
    "test:native-toolchain": "node --test scripts/check-native-toolchain.test.mjs scripts/node-pty-rebuild.test.mjs"
  },
  "keywords": [
    "electron",
    "productivity",
    "automation",
    "skills",
    "companion"
  ],
  "author": "HemSoft Developments",
  "license": "MIT",
  "dependencies": {
    "@convex-dev/aggregate": "^0.3.0",
    "@convex-dev/migrations": "^0.3.6",
    "@github/copilot-sdk": "1.0.14",
    "@napi-rs/keyring": "2.1.1",
    "@octokit/graphql": "^9.0.3",
    "@octokit/plugin-retry": "^8.1.0",
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/rest": "^22.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/instrumentation-dns": "^0.66.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@uiw/react-markdown-preview": "^5.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^6.0.0",
    "allotment": "^1.20.5",
    "convex": "1.46.0",
    "cron-parser": "^5.10.2",
    "electron-store": "^11.0.2",
    "electron-window-state": "^5.0.3",
    "koffi": "3.2.1",
    "lucide-react": "^1.23.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remark-gemoji": "^8.0.0",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "8.0.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@e18e/cli": "0.7.0",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint-react/eslint-plugin": "^5.10.3",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/istanbul-lib-instrument": "1.7.8",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-istanbul": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "convex-test": "0.0.59",
    "dependency-cruiser": "^18.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "es-module-lexer": "3.0.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "^4.1.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "istanbul-lib-instrument": "6.0.3",
    "knip": "^6.24.0",
    "lint-staged": "^17.6.0",
    "markdownlint-cli": "0.49.1",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.9.4",
    "puppeteer-core": "25.11.0",
    "react-doctor": "0.9.13",
    "react-scan": "^0.5.7",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "8.3.0",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "5.0.3",
    "vitest-axe": "^0.1.0",
    "node-gyp": "12.4.0"
  },
  "optionalDependencies": {
    "@github/copilot-darwin-arm64": "^1.0.95",
    "@github/copilot-darwin-x64": "^1.0.68",
    "@github/copilot-linux-x64": "^1.0.91",
    "@github/copilot-win32-x64": "^1.0.68"
  },
  "overrides": {
    "react-doctor": "$react-doctor",
    "@electron/get": "5.1.0",
    "basic-ftp": "6.2.1",
    "body-parser": "^1.20.6",
    "brace-expansion": "^5.0.11",
    "browserslist": "^4.28.8",
    "compression": "1.8.2",
    "electron-builder-squirrel-windows": "26.15.3",
    "@xmldom/xmldom": "0.8.15",
    "@grpc/grpc-js": "^1.14.5",
    "fast-uri": "^3.1.6",
    "form-data": "^4.0.6",
    "ip-address": "^10.3.1",
    "linkify-it": "^5.0.2",
    "lighthouse": "^13.4.1",
    "markdown-it": "^14.2.0",
    "nanoid": "^3.3.18",
    "node-abi": "^4.35.0",
    "protobufjs": "^7.6.5",
    "proxy-addr": "2.0.8",
    "qs": "^6.15.2",
    "smol-toml": "1.8.0",
    "source-map-js": "1.2.2",
    "tar": "^7.5.22",
    "tmp": "^0.2.6",
    "undici": "^7.29.0",
    "uuid": "^11.1.1",
    "vite": "$vite",
    "ws": "^8.20.1"
  },
  "patchedDependencies": {
    "app-builder-lib@26.15.3": "patches/app-builder-lib@26.15.3.patch",
    "@stryker-mutator/vitest-runner@10.0.0": "patches/@stryker-mutator%2Fvitest-runner@10.0.0.patch",
    "node-pty@1.1.0": "patches/node-pty@1.1.0.patch"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.2",
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings 0 --no-warn-ignored"
    ],
    "*.{js,json,css}": [
      "prettier --write"
    ],
    "*.md": [
      "markdownlint --dot --config .markdownlint-cli2.jsonc --configPointer /config"
    ]
  }
}
