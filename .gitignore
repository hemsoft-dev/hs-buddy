coverage-electron/
reports/mutation/
.stryker-tmp/
release/
*.local

# Playwright
playwright-report/
playwright-electron-report/
electron-e2e-results.xml
test-results/

# Lighthouse CI
.lighthouseci/

# Environment
.env
.env.local
.env.*.local

# Logs
*.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

