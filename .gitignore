*.tsbuildinfo

# Editor
.vscode/
.idea/
.claude/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Electron
out/
.tmp/

# Prompt checkpoints (local state, not tracked)
.github/prompts/.status-checkpoint

# Local debug helpers
_cdp.cjs
.playwright-mcp/
bench-output.txt
bench-results.json

# Code Index generated artifacts (local-only indexed search data)
.codeindex/

# Ralph loop logs (root only — scripts/ralph* should be tracked)
/ralph*.log

# Never ignore anything in scripts/ (overrides *.log* etc.)
!scripts/**

# Per-developer hooks settings (audio toggle, etc.)
.github/hooks/hooks-settings.json
/reports/react-doctor/
/reports/crap/
